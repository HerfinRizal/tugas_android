<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Wadah / Container untuk Fragment -->
    <FrameLayout
        android:id="@+id/frl_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_frg1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol untuk Fragment 1 -->
    <Button
        android:id="@+id/btn_frg1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_fragment_1"
        android:textColor="@android:color/white"
        android:backgroundTint="#2F56C8"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_frg2"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <!-- Tombol untuk Fragment 2 (Sesuai modul di atas) -->
    <Button
        android:id="@+id/btn_frg2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_fragment_2"
        android:textColor="@android:color/white"
        android:backgroundTint="#2F56C8"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_frg1"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
