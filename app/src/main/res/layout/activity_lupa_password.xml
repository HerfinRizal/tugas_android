<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:gravity="center_horizontal"
    android:background="#FFFFFF">

    <!-- Icon / Gambar Gembok Lupa Password -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="15dp"
        android:src="@drawable/gembok"
        android:contentDescription="@string/content_desc_gembok" /> <!-- Ganti "gembok" dengan nama file gambar yang kamu masukkan -->

    <!-- Judul Kesulitan Login -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kesulitan Login?"
        android:textSize="24sp"
        android:textAlignment="center"
        android:layout_marginBottom="4dp"
        android:textColor="#000000"
        android:textStyle="bold"/>

    <!-- Subjudul Atur Ulang Kata Sandi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/atur_ulang_sandi"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginBottom="12dp"
        android:textColor="#666666"/>

    <!-- Deskripsi / Petunjuk -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Masukkan email dan kami akan mengirimi Anda tautan untuk kembali ke akun Anda."
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"
        android:textColor="#000000"/>

    <!-- Input Email -->
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukan Email Anda"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:textSize="16sp"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:layout_marginBottom="16dp"/>

    <!-- Tombol Kirim Tautan Masuk -->
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KIRIM TAUTAN MASUK"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00BCD4"
        android:layout_marginBottom="16dp"
        android:minHeight="40dp" />

    <!-- TextView Atur Ulang Password sesuai snippet gambar -->
    <TextView
        android:id="@+id/aturUlangPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Tidak bisa mengatur ulang kata sandi anda?"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="20sp">
    </TextView>

</LinearLayout>
